{
    "name": "tfs-playwright-tests",
    "version": "1.0.0",
    "private": true,
    "description": "TFS / The Fuel Store QA automation project (Playwright + k6)",
    "scripts": {
        "test": "npx playwright test -c .",
        "test:headed": "npx playwright test -c . --headed",
        "test:ui": "npx playwright test -c . --ui",
        "load:smoke": "k6 run --env SCENARIO=smoke 10-tfs.load.k6.js",
        "load:load": "k6 run --env SCENARIO=load 10-tfs.load.k6.js",
        "load:spike": "k6 run --env SCENARIO=spike 10-tfs.load.k6.js",
        "load:soak": "k6 run --env SCENARIO=soak 10-tfs.load.k6.js",
        "load:all": "k6 run 10-tfs.load.k6.js"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.2",
        "@playwright/test": "^1.52.0",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0"
    }
}
